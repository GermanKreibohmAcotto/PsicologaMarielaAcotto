---
import Layout from '../layouts/Layout.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import { site } from '../config/site';
---

<Layout
	title={`Página no encontrada | ${site.nombreCompleto}`}
	description="La página que buscás no existe."
	noindex
>
	<main class="flex min-h-screen flex-col items-center justify-center px-4 py-16 text-center">
		<p class="font-display text-6xl text-verde" aria-hidden="true">404</p>
		<h1 class="mt-4 font-display text-3xl text-ink">Esta página no existe</h1>
		<p class="mt-3 max-w-md text-ink-soft">
			Puede que el enlace esté roto o que la página se haya movido. Volvé al inicio o escribime
			directamente.
		</p>
		<div class="mt-8 flex flex-col gap-4 sm:flex-row">
			<a
				href="/"
				class="inline-flex min-h-[44px] items-center justify-center rounded-pill border-2 border-border-strong px-6 py-3.5 font-semibold text-ink transition hover:bg-surface-alt"
			>
				Volver al inicio
			</a>
			<CtaWhatsApp mensaje="Hola Mariela, me gustaría consultar por una sesión.">
				Escribime por WhatsApp
			</CtaWhatsApp>
		</div>
	</main>
</Layout>
