---
import '../styles/global.css';
import sourceSerifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import { site } from '../config/site';

interface Props {
  /** Título de página completo (≤ 60 caracteres recomendado). */
  title: string;
  /** Meta description (≤ 155 caracteres recomendado). */
  description: string;
  /** true en páginas que no deben indexarse (ej. 404). */
  noindex?: boolean;
  /** Bloques JSON-LD específicos de la página (Psychologist, FAQPage, etc). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#f7f4ef" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="HA3F4A-EfWwQ97Ham1cOD7eJb7klc0dASjblP4kzhXM" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content={site.nombreCompleto} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="msapplication-TileImage" content="/favicon.svg" />
		<meta name="msapplication-TileColor" content="#4A6B5D" />

		<!-- Fuente del hero (LCP): precargada porque es self-hosted y crítica para
		     el primer render. El resto de las fuentes llega por la hoja de
		     estilos, sin bloquear el render ni depender de un tercero. -->
		<link rel="preload" as="font" type="font/woff2" href={sourceSerifLatin} crossorigin />

		<!-- Habilita el estado inicial "oculto" de las animaciones de scroll
		     (.reveal en global.css). Sin este script el contenido queda visible
		     siempre — nunca depende de que el JS más abajo llegue a correr. -->
		<script is:inline>
			document.documentElement.classList.add('js-reveal');
		</script>

		{jsonLd.map((block) => (
			<script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
		))}
	</head>
	<body class="bg-bg text-ink">
		<slot />
	</body>
</html>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
	const revealAll = () => revealEls.forEach((el) => el.classList.add('is-visible'));

	if (reduceMotion || !('IntersectionObserver' in window)) {
		revealAll();
	} else {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
		);
		revealEls.forEach((el) => observer.observe(el));

		// Red de seguridad: si el observer nunca llega a disparar por el motivo
		// que sea, el contenido no debe quedar invisible para siempre.
		setTimeout(revealAll, 2000);
	}
</script>
