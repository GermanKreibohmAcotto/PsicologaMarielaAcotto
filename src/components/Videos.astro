---
import Section from './Section.astro';
import { videos } from '../config/site';
---

<Section
	id="videos"
	eyebrow="Volver a Empezar"
	titulo="Charlas sobre salud mental"
	descripcion="Columnas sobre salud mental en Radio Jardin Yerba Buena, con reflexiones sobre distintos temas de la vida cotidiana."
	tono="alt"
>
	<div
		id="videos-track"
		role="region"
		aria-label="Videos destacados"
		tabindex="0"
		class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4"
	>
		{videos.map((video) => (
			<div class="w-[280px] shrink-0 snap-start sm:w-[340px]">
				<button
					type="button"
					class="video-card group relative block aspect-video w-full overflow-hidden rounded-card bg-ink shadow-soft"
					data-video-id={video.id}
					data-video-title={video.titulo}
					aria-label={`Reproducir video: ${video.titulo}`}
				>
					<img
						src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
						alt=""
						loading="lazy"
						width="480"
						height="360"
						class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
					/>
					<span class="absolute inset-0 flex items-center justify-center bg-ink/10">
						<span class="flex h-14 w-14 items-center justify-center rounded-pill bg-verde/90 text-white shadow-soft transition-transform duration-200 group-hover:scale-110">
							<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="ml-1 h-6 w-6" fill="currentColor">
								<path d="M8 5v14l11-7z"></path>
							</svg>
						</span>
					</span>
				</button>
				<p class="mt-3 font-display text-base text-ink">{video.titulo}</p>
			</div>
		))}
	</div>
	<div class="mt-2 flex justify-end gap-2">
		<button type="button" id="videos-prev" class="slider-btn" aria-label="Video anterior">
			<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M15 18l-6-6 6-6"></path>
			</svg>
		</button>
		<button type="button" id="videos-next" class="slider-btn" aria-label="Video siguiente">
			<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M9 18l6-6-6-6"></path>
			</svg>
		</button>
	</div>
</Section>

<dialog id="video-modal" class="video-modal" aria-labelledby="video-modal-title">
	<div class="flex items-center justify-between gap-4 p-3">
		<h2 id="video-modal-title" class="truncate font-display text-base text-ink">Video</h2>
		<button type="button" id="video-modal-close" class="video-modal-close" aria-label="Cerrar video">
			<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>
	<div class="aspect-video w-full bg-ink">
		<iframe
			id="video-modal-frame"
			class="h-full w-full"
			title=""
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
			allowfullscreen
		></iframe>
	</div>
</dialog>

<style>
	#videos-track {
		scrollbar-width: thin;
		scrollbar-color: var(--color-border-strong) transparent;
	}

	.slider-btn {
		display: flex;
		height: 2.75rem;
		width: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-pill);
		border: 1.5px solid var(--color-border-strong);
		color: var(--color-ink);
		transition: background-color 0.15s ease;
	}

	.slider-btn:hover {
		background-color: var(--color-surface);
	}

	.video-modal {
		/* El reset de Tailwind pone "margin: 0" en todos los elementos, lo que
		   pisa el "margin: auto" que el navegador usa por defecto para centrar
		   un <dialog> abierto con showModal(). Sin esto queda pegado arriba a
		   la izquierda en vez de centrado. */
		margin: auto;
		width: min(92vw, 960px);
		max-height: calc(100vh - 2rem);
		border: none;
		border-radius: var(--radius-card);
		padding: 0;
		background-color: var(--color-surface);
		box-shadow: var(--shadow-soft);
	}

	.video-modal::backdrop {
		background-color: rgb(47 62 56 / 0.7);
	}

	.video-modal-close {
		display: flex;
		height: 2.5rem;
		width: 2.5rem;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-pill);
		color: var(--color-ink);
		transition: background-color 0.15s ease;
	}

	.video-modal-close:hover {
		background-color: var(--color-surface-alt);
	}
</style>

<script>
	const track = document.getElementById('videos-track');
	const prevBtn = document.getElementById('videos-prev');
	const nextBtn = document.getElementById('videos-next');

	if (track && prevBtn && nextBtn) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const scrollByCard = (direction: number) => {
			const card = track.querySelector<HTMLElement>(':scope > div');
			const amount = (card?.offsetWidth ?? 300) + 24;
			track.scrollBy({ left: direction * amount, behavior: reduceMotion ? 'auto' : 'smooth' });
		};

		prevBtn.addEventListener('click', () => scrollByCard(-1));
		nextBtn.addEventListener('click', () => scrollByCard(1));
	}

	const modal = document.querySelector<HTMLDialogElement>('#video-modal');
	const modalFrame = document.querySelector<HTMLIFrameElement>('#video-modal-frame');
	const modalTitle = document.getElementById('video-modal-title');
	const modalClose = document.getElementById('video-modal-close');

	if (modal && modalFrame && modalTitle) {
		const closeVideoModal = () => modal.close();

		track?.querySelectorAll<HTMLButtonElement>('.video-card').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.videoId;
				const title = btn.dataset.videoTitle ?? 'Video';
				if (!id) return;
				modalFrame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
				modalFrame.title = title;
				modalTitle.textContent = title;
				modal.showModal();
				// Sin esto la scrollbar del fondo sigue ocupando espacio y el
				// modal (centrado respecto del viewport completo) queda visualmente
				// descentrado hacia la izquierda.
				document.documentElement.style.overflow = 'hidden';
			});
		});

		modalClose?.addEventListener('click', closeVideoModal);

		// Un clic en el backdrop llega con el <dialog> mismo como target
		// (el contenido visible tiene padding: 0, así que cualquier hijo real
		// nunca coincide con "modal").
		modal.addEventListener('click', (event) => {
			if (event.target === modal) closeVideoModal();
		});

		// Cubre los tres caminos de cierre (botón, backdrop, Escape) en un
		// solo lugar: el evento "close" nativo del <dialog> se dispara siempre.
		modal.addEventListener('close', () => {
			modalFrame.src = '';
			document.documentElement.style.overflow = '';
		});
	}
</script>
