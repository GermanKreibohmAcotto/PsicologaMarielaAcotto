---
import Section from './Section.astro';

const pasos = [
	{
		titulo: 'Escribís por WhatsApp',
		descripcion: 'Contás brevemente qué te trae a la consulta.',
	},
	{
		titulo: 'Coordinamos un primer encuentro',
		descripcion: 'Buscamos día y horario según disponibilidad, presencial u online.',
	},
	{
		titulo: 'Nos conocemos',
		descripcion: 'La primera entrevista sirve para pensar juntos cómo seguir.',
	},
];
---

<Section
	id="como-empezar"
	eyebrow="Primer paso"
	titulo="Cómo empezar"
	descripcion="Dar el primer paso suele ser lo más difícil. Esto es todo lo que hace falta."
	tono="alt"
	centrado
>
	<ol class="grid gap-10 sm:grid-cols-3">
		{pasos.map((paso) => (
			<li class="reveal-item text-center sm:text-left">
				<span class="mx-auto block h-1 w-10 bg-terracota-dark sm:mx-0" aria-hidden="true"></span>
				<h3 class="mt-5 font-display text-lg text-ink">{paso.titulo}</h3>
				<p class="mt-2 text-ink-soft">{paso.descripcion}</p>
			</li>
		))}
	</ol>
</Section>
