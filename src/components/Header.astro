---
import { site } from '../config/site';
import CtaWhatsApp from './CtaWhatsApp.astro';

const links = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#sobre-mi', label: 'Sobre mí' },
	{ href: '#instituciones', label: 'Instituciones' },
	{ href: '#videos', label: 'Charlas' },
	{ href: '#preguntas-frecuentes', label: 'Preguntas frecuentes' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
		<a href="#inicio" class="font-display text-lg font-semibold text-ink">
			{site.nombreCompleto}
		</a>

		<nav aria-label="Secciones de la página" class="hidden lg:block">
			<ul class="flex items-center gap-6 text-sm font-medium text-ink">
				{links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-verde">{link.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				id="mobile-menu-toggle"
				class="inline-flex h-11 w-11 items-center justify-center rounded-pill border border-border-strong text-ink transition-colors hover:bg-surface-alt lg:hidden"
				aria-label="Abrir menú de navegación"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					aria-hidden="true"
					focusable="false"
					viewBox="0 0 24 24"
					class="h-5 w-5"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="4" y1="7" x2="20" y2="7"></line>
					<line x1="4" y1="12" x2="20" y2="12"></line>
					<line x1="4" y1="17" x2="20" y2="17"></line>
				</svg>
			</button>

			<CtaWhatsApp
				mensaje="Hola Mariela, me gustaría consultar por una sesión."
				size="sm"
				class="shrink-0"
			>
				Escribime
			</CtaWhatsApp>
		</div>
	</div>
</header>

<dialog
	id="mobile-menu"
	class="mobile-menu"
	aria-label="Menú de navegación"
>
	<div class="flex items-center justify-between px-6 py-4">
		<p class="font-display text-lg font-semibold text-ink">{site.nombreCompleto}</p>
		<button
			type="button"
			id="mobile-menu-close"
			class="inline-flex h-11 w-11 items-center justify-center rounded-pill border border-border-strong text-ink transition-colors hover:bg-surface-alt"
			aria-label="Cerrar menú"
		>
			<svg
				aria-hidden="true"
				focusable="false"
				viewBox="0 0 24 24"
				class="h-5 w-5"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="6" y1="6" x2="18" y2="18"></line>
				<line x1="18" y1="6" x2="6" y2="18"></line>
			</svg>
		</button>
	</div>
	<nav aria-label="Secciones de la página">
		<ul class="flex flex-col px-2">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						data-mobile-menu-link
						class="mobile-menu-link block rounded-card px-6 py-4 text-xl font-medium text-ink transition-colors hover:bg-surface-alt hover:text-verde"
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<div class="px-6 pt-6">
		<CtaWhatsApp
			mensaje="Hola Mariela, me gustaría consultar por una sesión."
			variant="primary"
			class="w-full"
		>
			Escribime por WhatsApp
		</CtaWhatsApp>
	</div>
</dialog>

<style>
	/* Fullscreen overlay a nivel del viewport: el <dialog> se "despega" del
	   header y ocupa toda la pantalla para que los links queden cómodos al
	   pulgar. Sin esto, el dialog respeta el contexto del header. */
	.mobile-menu {
		margin: 0;
		padding: 0;
		width: 100vw;
		height: 100dvh;
		max-width: 100vw;
		max-height: 100dvh;
		border: none;
		border-radius: 0;
		background-color: var(--color-bg);
		color: var(--color-ink);
	}

	.mobile-menu::backdrop {
		background-color: transparent;
	}

	/* Reduce la altura del viewport en móviles con barra de URL dinámica
	   (100dvh en vez de 100vh evita quedar tapado por la barra). */
	@supports not (height: 100dvh) {
		.mobile-menu {
			height: 100vh;
		}
	}
</style>

<script>
	const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
	const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
	const closeBtn = document.getElementById('mobile-menu-close') as HTMLButtonElement | null;

	if (dialog && toggle && closeBtn) {
		const openMenu = () => {
			dialog.showModal();
			toggle.setAttribute('aria-expanded', 'true');
			// El body sigue scrolleable dentro del dialog mismo, pero la página
			// de fondo queda quieta para no perder el contexto. Mismo truco que
			// el modal de video en Videos.astro.
			document.documentElement.style.overflow = 'hidden';
		};

		const closeMenu = () => {
			dialog.close();
			toggle.setAttribute('aria-expanded', 'false');
			document.documentElement.style.overflow = '';
		};

		toggle.addEventListener('click', () => {
			if (dialog.open) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		closeBtn.addEventListener('click', closeMenu);

		// Cerrar y refrescar aria-expanded al disparar el evento "close" nativo
		// (cubre Escape y cualquier llamada programática a dialog.close()). El
		// backdrop externo lo cierra el browser de forma nativa — no se necesita
		// un listener manual acá, y un listener sobre el dialog mismo no ayuda
		// porque su padding es 0 (toda "superficie" visible es un hijo).
		dialog.addEventListener('close', () => {
			toggle.setAttribute('aria-expanded', 'false');
			document.documentElement.style.overflow = '';
		});

		// Al tocar un link del menú: dejar que el browser navegue al anchor y
		// cerrar el dialog después (un setTimeout mínimo para que el browser
		// procese la navegación antes de remover el dialog del top layer).
		dialog.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-link]').forEach((link) => {
			link.addEventListener('click', () => {
				setTimeout(closeMenu, 0);
			});
		});

		// Si el viewport pasa a lg y el menú quedó abierto por una rotación,
		// cerrarlo. El nav inline ya muestra los mismos links en desktop.
		const mql = window.matchMedia('(min-width: 1024px)');
		mql.addEventListener('change', (event) => {
			if (event.matches && dialog.open) closeMenu();
		});
	}
</script>
