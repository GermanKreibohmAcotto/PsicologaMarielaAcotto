---
import { Image } from 'astro:assets';
import consultorio from '../assets/consultorio.jpg';
import CtaWhatsApp from './CtaWhatsApp.astro';
import { site } from '../config/site';
---

<section id="inicio" class="relative isolate scroll-mt-24 overflow-hidden">
	<Image
		src={consultorio}
		alt=""
		width={1920}
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 -z-20 h-full w-full object-cover"
	/>
	<!-- Degradé decorativo, no aporta información: la tarjeta de texto abajo ya
	     es opaca y garantiza contraste AA sin depender de la foto de fondo. -->
	<div
		class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/50 via-ink/10 to-transparent lg:bg-gradient-to-r lg:from-ink/40 lg:via-ink/5 lg:to-transparent"
		aria-hidden="true"
	>
	</div>

	<div class="mx-auto flex min-h-[560px] max-w-6xl items-end px-4 py-12 sm:min-h-[640px] sm:px-6 sm:py-16 lg:min-h-[720px] lg:items-center lg:px-8 lg:py-24">
		<div class="reveal max-w-xl rounded-card bg-bg p-6 shadow-soft sm:p-10">
			<p class="mb-4 inline-flex items-center gap-2 rounded-pill bg-surface-alt px-3.5 py-1.5 text-xs font-semibold tracking-wide text-verde uppercase">
				<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-verde" aria-hidden="true"></span>
				{site.profesion} · {site.ciudad}
			</p>
			<h1 class="font-display text-4xl leading-tight text-ink sm:text-5xl">
				Un espacio de escucha en {site.ciudad}, {site.provincia}
			</h1>
			<p class="mt-6 max-w-xl text-lg text-ink-soft">
				Psicoterapia individual para jóvenes y adultos, desde el psicoanálisis y la psicoterapia
				focalizada. De forma presencial o de manera online.
			</p>
			<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
				<CtaWhatsApp mensaje="Hola Mariela, me gustaría consultar por una sesión.">
					Escribime por WhatsApp
				</CtaWhatsApp>
				<a
					href="#servicios"
					class="text-sm font-semibold text-ink underline decoration-border-strong decoration-2 underline-offset-4 hover:text-verde"
				>
					Ver cómo puedo ayudarte
				</a>
			</div>
			<p class="mt-6 text-sm text-ink-soft">{site.tratamiento} {site.nombre} · {site.matricula}</p>
		</div>
	</div>
</section>
