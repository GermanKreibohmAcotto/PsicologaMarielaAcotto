---
/**
 * Envoltorio común para cada bloque de la página: mismo ancho, mismo ritmo
 * vertical, encabezado consistente. Todas las secciones usan <h2> — el único
 * <h1> de la página vive en el Hero.
 */
interface Props {
	id: string;
	eyebrow?: string;
	titulo: string;
	descripcion?: string;
	tono?: 'base' | 'alt' | 'warm';
	centrado?: boolean;
}

const { id, eyebrow, titulo, descripcion, tono = 'base', centrado = false } = Astro.props;

const tonoClase = {
	base: 'bg-bg',
	alt: 'bg-surface',
	warm: 'bg-surface-warm',
}[tono];

const headingId = `${id}-titulo`;
---

<section
	id={id}
	class:list={['reveal scroll-mt-24 py-20 md:py-32 lg:py-40', tonoClase]}
	aria-labelledby={headingId}
>
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<header class:list={['max-w-2xl', { 'mx-auto text-center': centrado }]}>
			{eyebrow && (
				<p
					class:list={[
						'mb-4 inline-flex items-center gap-2 whitespace-nowrap rounded-pill bg-surface-alt px-3.5 py-1.5 text-xs font-semibold tracking-wide text-verde uppercase',
						{ 'mx-auto': centrado },
					]}
				>
					<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-verde" aria-hidden="true"></span>
					{eyebrow}
				</p>
			)}
			<h2 id={headingId} class="font-display text-3xl text-ink md:text-4xl lg:text-5xl">{titulo}</h2>
			{descripcion && <p class="mt-4 text-lg text-ink-soft">{descripcion}</p>}
		</header>
		<div class="mt-10 md:mt-14">
			<slot />
		</div>
	</div>
</section>
