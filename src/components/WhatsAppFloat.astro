---
import { buildWhatsAppUrl } from '../lib/whatsapp';

// Botón flotante persistente: es el punto de contacto que más convierte en
// mobile, donde va a estar la mayor parte del tráfico.
const href = buildWhatsAppUrl('Hola Mariela, me gustaría consultar por una sesión.');
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="whatsapp-float"
	aria-label="Escribir por WhatsApp (abre en una pestaña nueva)"
>
	<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor">
		<path
			d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
		></path>
		<path
			d="M12.045 21.785h-.005a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c0-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.884 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
		></path>
	</svg>
</a>

<style>
	.whatsapp-float {
		position: fixed;
		right: 1rem;
		bottom: calc(1rem + env(safe-area-inset-bottom));
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-verde);
		color: white;
		box-shadow: var(--shadow-soft);
		transition:
			filter 0.15s ease,
			transform 0.15s ease;
	}

	.whatsapp-float:hover {
		filter: brightness(0.9);
	}

	.whatsapp-float:active {
		transform: scale(0.96);
	}

	/* Este botón flota sobre contenido variable (a veces fondo claro, a veces
	   el footer oscuro), así que no puede depender de un solo color de
	   outline. El anillo claro pegado al botón queda visible sobre fondos
	   oscuros; el anillo oscuro exterior queda visible sobre fondos claros:
	   siempre hay al menos uno con contraste suficiente. */
	.whatsapp-float:focus-visible {
		outline: none;
		box-shadow:
			0 0 0 3px var(--color-bg),
			0 0 0 6px var(--color-ink),
			var(--shadow-soft);
	}

	@media (prefers-reduced-motion: reduce) {
		.whatsapp-float {
			transition: none;
		}

		.whatsapp-float:active {
			transform: none;
		}
	}
</style>
