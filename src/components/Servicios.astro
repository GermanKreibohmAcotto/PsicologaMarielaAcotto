---
import Section from './Section.astro';
import { servicios } from '../config/site';
---

<Section
	id="servicios"
	eyebrow="Servicios"
	titulo="Cómo puedo ayudarte"
	descripcion="Atención a jóvenes, adultos y adultos mayores, y trabajo junto a instituciones educativas."
	tono="base"
>
	<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{servicios.map((s) => (
			<li class="reveal-item hover-lift rounded-card border border-border bg-surface p-6 shadow-soft">
				{s.iconPath && (
					<svg
						aria-hidden="true"
						focusable="false"
						viewBox="0 0 24 24"
						class="mb-4 h-7 w-7 text-verde"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d={s.iconPath} />
					</svg>
				)}
				<h3 class="font-display text-xl text-ink">{s.titulo}</h3>
				<p class="mt-3 text-ink-soft">{s.descripcion}</p>
			</li>
		))}
	</ul>
</Section>
